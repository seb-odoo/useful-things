# Copy to ~/.config/odoo-dev/config.env and edit, or drop a copy in a repo root to override that one
# repo. Every key is optional: leave a line out to take the default in the comment. Values are
# literal, no quotes, no expansion.
#
# The same file, and the same precedence (environment, repo, shared, default), for every repo that
# takes part in the dev container: the generator here reads it, and so does each gateway's install.

# Where the repos are cloned. Default: $HOME/repo
REPO_ROOT=/home/me/repo

# Where the bundle worktrees and the shared .devcontainer live. Default: $HOME/src/odoo
WORKTREE_ROOT=/home/me/src/odoo

# Defaults follow the XDG variables, or $HOME/.config, $HOME/.local/state, $HOME/.cache and
# $HOME/.local/share when those are unset.
CONFIG_ROOT=/home/me/.config
STATE_ROOT=/home/me/.local/state
CACHE_ROOT=/home/me/.cache
SHARE_ROOT=/home/me/.local/share

# The python the dev containers run odoo-bin with, and where the venvs live.
# Defaults: $HOME/virtualenvs/odoo20 and $HOME/virtualenvs
VENV=/home/me/virtualenvs/odoo20
VENV_ROOT=/home/me/virtualenvs

# What ends the name of every bundle of yours: the scripts tell your branches from the others by
# it. Default: --$USER
BUNDLE_SUFFIX=--me

# The remote of your owl fork, where owl bundle branches are pushed. Default: origin
OWL_DEV_REMOTE=origin

# Postgres as seen from inside a dev container. Defaults: $USER and /var/run/postgresql
PG_USER=me
PG_HOST=/var/run/postgresql

# The dev container base image, whose own trust store goes into any bundle a gateway builds.
# Default: mcr.microsoft.com/devcontainers/base:ubuntu-22.04
CONTAINER_BASE_IMAGE=mcr.microsoft.com/devcontainers/base:ubuntu-22.04

# The memory a bundle container may use, as podman --memory takes it. Default: 8g
CONTAINER_MEMORY=8g

# How many agents bundle-ctl lets run in a terminal before it queues the next one. The bundles
# open in a VS Code window do not count. Default: 8
BUNDLE_CTL_MAX_AGENTS=8

# The CPUs bundle-ctl gives to the heavy runs of the containers (test runs, installs, servers), as
# a list such as 4-11. A core is used when all its threads are in the list.
# Default: every core but the first third, which stays to the desktop
# BUNDLE_CTL_RUN_CPUS=4-11

# The memory, in GB, that stays available when a run starts while another one runs. Default: 4
BUNDLE_CTL_RUN_MIN_FREE_GB=4

# A folder whose dev container asks bundle-ctl as the host does, with no bundle of its own: a
# container made to work on these tools. `orepo` opens it, `orepo --host` the host itself.
# Default: none
BUNDLE_CTL_HOST_FOLDER=/home/me/repo/my-tools

# A command that runs its arguments with the bundle repos and nothing else of this machine (no
# home, no network), as `<command> --dir <folder> -- <program> ...`. When set, the bundle scripts
# run what a fetched branch brings (odoo/addons/web/tooling/enable.sh) through it. Default: none
HOST_BOX=/home/me/.local/bin/my-box

# The terminal bundle-ctl starts an agent in, the command of the agent appended. {bundle} is the
# bundle name. Default: gnome-terminal --window --title {bundle} --
# One server process holds every gnome-terminal window, where terminator takes ~70 MB per window.
# For a terminator window split in two, the agent next to a host shell in the bundle's folder:
# AGENT_TERMINAL=/home/me/repo/useful-things/bundle-ctl/agent-terminator.py {bundle}
AGENT_TERMINAL=gnome-terminal --window --title {bundle} --
