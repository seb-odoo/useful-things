// The dev container every bundle opens, minus whatever is optional: those come back as
// devcontainer.fragment.json files, merged in by build.py, so a machine that has none of them
// still gets a container that builds and runs.
//
// @KEY@ placeholders are expanded from config.env (see config.env.example beside this file,
// read by config.py). Edit this file, never the generated one.
{
  "name": "${localWorkspaceFolderBasename} (Claude sandbox)",
  "build": {
    "dockerfile": "Dockerfile",
    // Where the image symlinks ~/.bash_aliases. Passed as an arg so the path lives here with the
    // other @KEY@ ones and the Dockerfile stays free of any absolute path of its own.
    "args": { "CONTAINER_BASHRC": "@USEFUL_THINGS@/container-rw/devcontainer.bashrc" }
  },
  "remoteUser": "vscode",
  // 1. Disable this to stop VS Code from corrupting Podman's keep-id user namespace mapping
  "updateRemoteUserUID": true,
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,Z",
  "workspaceFolder": "/workspace",
  "mounts": [
    "source=@REPO_ROOT@/odoo/.git,target=@REPO_ROOT@/odoo/.git,type=bind,Z",
    "source=@REPO_ROOT@/enterprise/.git,target=@REPO_ROOT@/enterprise/.git,type=bind,Z",
    "source=@REPO_ROOT@/design-themes/.git,target=@REPO_ROOT@/design-themes/.git,type=bind,Z",
    "source=@REPO_ROOT@/documentation/.git,target=@REPO_ROOT@/documentation/.git,type=bind,Z",
    "source=@REPO_ROOT@/upgrade/.git,target=@REPO_ROOT@/upgrade/.git,type=bind,Z",
    "source=@REPO_ROOT@/upgrade-util/.git,target=@REPO_ROOT@/upgrade-util/.git,type=bind,Z",
    "source=@REPO_ROOT@/owl/.git,target=@REPO_ROOT@/owl/.git,type=bind,Z",
    "source=@REPO_ROOT@/sfu/.git,target=@REPO_ROOT@/sfu/.git,type=bind,Z",
    // Workspace .claude, .vscode and odools.toml are symlinks in each bundle pointing at these
    // absolute host paths; bind them at the same path (like the .git mounts above) so the symlinks
    // resolve in the container. Without this the workspace settings.json never loads, so
    // search.exclude (*.po/*.pot) is ignored and the Odoo extension can't read odools.toml.
    // The shared .claude is versioned in the claude-config repo, so the host path is itself a
    // symlink into it: mount the real directory, not the link.
    "source=@HOME@/.claude/external/src-odoo-claude,target=@WORKTREE_ROOT@/.claude,type=bind,Z",
    "source=@WORKTREE_ROOT@/.vscode,target=@WORKTREE_ROOT@/.vscode,type=bind,Z",
    "source=@USEFUL_THINGS@/odools.toml,target=@USEFUL_THINGS@/odools.toml,type=bind,readonly,Z",
    "source=@HOME@/.claude,target=/home/vscode/.claude,type=bind,Z",
    // The container's own CLAUDE_CONFIG_DIR, made by devcontainer/claude-config.py: a settings.json
    // it may write, and links to the rest of ~/.claude.
    "source=@CACHE_ROOT@/devcontainer/claude-config/${localWorkspaceFolderBasename},target=/home/vscode/.claude-container,type=bind,z",
    "source=@CONFIG_ROOT@/Code/User,target=/home/vscode/.config/Code/User,type=bind,readonly,Z",
    "source=@VENV_ROOT@,target=@VENV_ROOT@,type=bind,readonly,Z",
    "source=@SHARE_ROOT@/Odoo,target=/home/vscode/.local/share/Odoo,type=bind,z",
    // test-warden (parallel JS/Hoot test runner, ~/repo/TestWarden): reuse the host-built engine
    // binary + bundled client at the same path (like the venv above); rw so the engine can write
    // engine/.cache/. It launches chrome-headless-shell (auto-downloaded to $HOME/.cache/warden),
    // not the image's Chrome (which would need a display), so share that cache to fetch it once.
    // Lowercase z: shared relabel for the parallel containers, like the filestore/extensions mounts.
    "source=@REPO_ROOT@/TestWarden,target=@REPO_ROOT@/TestWarden,type=bind,z",
    "source=@CACHE_ROOT@/warden,target=/home/vscode/.cache/warden,type=bind,z",
    // DiscussModelParser (~/repo/DiscussModelParser): generates the @types/models.d.ts files
    // for the discuss/mail JS models. Same path as the host so the wrapper in
    // container-rw/devcontainer.bashrc works on both sides; dist/type-gen-idx.mjs is self-contained
    // rollup bundle (Node built-ins only), so the image's Node 22 is enough, no install.
    // rw so `git pull` + `npm run build` work in here (config.json's whitelist is inlined
    // into dist/ at build time). Lowercase z: shared relabel, like TestWarden above.
    "source=@REPO_ROOT@/DiscussModelParser,target=@REPO_ROOT@/DiscussModelParser,type=bind,z",
    "source=@HOME@/.local/bin/gh,target=/usr/local/bin/gh,type=bind,readonly,z",
    // Persist VS Code's extensions across bundles/rebuilds so they install once, not per container.
    // Bind (not a named volume) because no-new-privileges/cap-drop ALL means no runtime sudo to chown
    // a root-owned volume; keep-id + updateRemoteUserUID maps vscode -> host seb (1001), so a
    // seb-owned host dir is writable. Lowercase z: shared SELinux relabel for the parallel containers.
    "source=@CACHE_ROOT@/devcontainer/vscode-server-extensions,target=/home/vscode/.vscode-server/extensions,type=bind,z",
    // The shell helpers, reached as BASH_ENV and through the ~/.bash_aliases symlink the image
    // makes. The directory and not the file: a bind of a file pins its inode, and an editor that
    // writes by renaming over it leaves every running container on the dead copy, silently.
    // Read-only, as the host shells source it too (useful-things/.bashrc): edit it on the host. A
    // syntax error reaches every running container's next shell rather than waiting for a rebuild,
    // so `bash -n` it after editing.
    "source=@USEFUL_THINGS@/container-rw,target=@USEFUL_THINGS@/container-rw,type=bind,readonly,z",
    // The folder and not the vsix: rebuilding the vsix replaces the file, and a file bind keeps every
    // running container on the old copy, which its next attach would install over the new one.
    "source=@USEFUL_THINGS@/claude-autoopen,target=/home/vscode/.claude-autoopen,type=bind,readonly,Z",
    "source=@USEFUL_THINGS@/install-claude-autoopen.sh,target=/home/vscode/.install-claude-autoopen.sh,type=bind,readonly,Z",
    // bundle-ctl: the folder of the host daemon's socket, and its client at the host path so `bctl`
    // works on both sides. Read-only, so a container replaces neither the socket nor the client.
    "source=@STATE_ROOT@/bundle-ctl/sock,target=/run/bundle-ctl,type=bind,readonly,z",
    "source=@USEFUL_THINGS@/bundle-ctl/client,target=@USEFUL_THINGS@/bundle-ctl/client,type=bind,readonly,z",
    "source=/var/run/postgresql,target=/var/run/postgresql,type=bind"
  ],
  // Runs on the host before each start: a missing mount source stops the container from starting.
  "initializeCommand": "mkdir -p @STATE_ROOT@/bundle-ctl/sock && python3 @USEFUL_THINGS@/devcontainer/claude-config.py ${localWorkspaceFolderBasename}",
  "postCreateCommand": "grep -q '@VENV@/bin/activate' ~/.bashrc || echo 'source @VENV@/bin/activate' >> ~/.bashrc",
  // Install the in-house claude-autoopen extension (see useful-things/claude-autoopen), which opens a
  // Claude Code tab on window open when none is present. Idempotent: skips if already installed.
  "postAttachCommand": "bash /home/vscode/.install-claude-autoopen.sh",
  // Reached via the host nginx proxy (~/repo/useful-things/proxy) by bundle name, so don't let
  // every window forward Odoo to the same host port and collide.
  "portsAttributes": {
    "8069": { "onAutoForward": "ignore" },
    "8072": { "onAutoForward": "ignore" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "tyriar.sort-lines",
        "odoo.odoo",
        "odoo.owl-vision"
      ],
      "settings": {
        // Upgrade folders like saas~19.5 match Claude's Windows short-name check (~<digit>), which
        // only bypass mode skips: the allow-all hook and dontAsk still prompt on every write.
        "claudeCode.allowDangerouslySkipPermissions": true,
        // Access is via the nginx proxy by name; don't forward Odoo ports to the host.
        "remote.autoForwardPorts": false
      }
    }
  },
  "runArgs": [
    "--net=bridge",
    "--cap-drop=ALL",
    "--security-opt=no-new-privileges",
    "--userns=keep-id",
    // Several bundles run at once: a runaway test run gets killed in its container rather than
    // pushing the whole host into swap.
    "--memory=@CONTAINER_MEMORY@",
  ],
  "containerEnv": {
    // Source the dev helpers (odoo-bin/ott/obet/...) in non-interactive shells (e.g. the agent's
    // `bash -c`), which don't read ~/.bashrc. The mounted file itself, so this holds whether or not
    // the ~/.bash_aliases symlink is there; that symlink is what ~/.bashrc, install-claude-path.sh
    // and the Bash( ... ) permission rules still reach it by.
    "BASH_ENV": "@USEFUL_THINGS@/container-rw/devcontainer.bashrc",
    // Where claude-autoopen finds agent-run.sh, the mount above.
    "BUNDLE_CTL_CLIENT": "@USEFUL_THINGS@/bundle-ctl/client",
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude-container",
    "HOME": "/home/vscode",
    "GIT_DISCOVERY_ACROSS_FILESYSTEM": "1",
    // Disable commit signing in the sandbox. The repo's bind-mounted .git/config (shared with the
    // host) sets commit.gpgsign=true, and the SSH signingKey @HOME@/.ssh/id_rsa.pub isn't mounted
    // here, so git aborts with "Couldn't load public key". A --global override loses to repo-local
    // config and editing .git/config would change the host too; GIT_CONFIG_* env takes precedence
    // over all config files and is container-only. Host commits stay signed.
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "commit.gpgsign",
    "GIT_CONFIG_VALUE_0": "false",
    "ODOO_PROXY_HOST": "${localWorkspaceFolderBasename}",
    // Make the reused 3.12 venv the default interpreter for every process (not just interactive
    // shells), so odoo-bin (#!/usr/bin/env python3) doesn't fall back to the base image's 3.10.
    // Hardcoded: ${containerEnv:PATH} is NOT resolved inside containerEnv (only in remoteEnv) and
    // would clobber PATH literally. Trailing dirs mirror the base image PATH.
    "PATH": "@VENV@/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "PGHOST": "@PG_HOST@",
    "PGUSER": "@PG_USER@",
    "VIRTUAL_ENV": "@VENV@"
  }
}
