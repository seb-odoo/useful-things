#!/bin/sh
dir=~/.local/state/ssh-github-mux
dbus-monitor --session "type='signal',interface='org.cinnamon.ScreenSaver',member='ActiveChanged'" |
    while read -r line; do
        [ "$line" = "boolean false" ] && [ -e "$dir/request/held" ] &&
            now=$(mktemp "$dir/now.XXXXXX") && echo "the screen was unlocked" > "$now" &&
            mv -fT "$now" "$dir/request/now"
    done
