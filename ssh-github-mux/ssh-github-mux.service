# The shared connection to github.com, started by ssh-github-mux.path, see README.md.
# %h/.local/state and not %S, here and in the .path: systemd 249 resolves %S to ~/.config.

[Unit]
Description=Shared SSH connection to github.com
StartLimitIntervalSec=0
Wants=ssh-github-mux-probe.timer

[Service]
ExecCondition=%h/.local/share/ssh-github-mux/here
ExecStartPre=/usr/bin/mkdir -p %h/.local/state/ssh-github-mux/sock
ExecStartPre=/usr/bin/rm -f %h/.local/state/ssh-github-mux/sock/up
# A crash of the host skips ExecStopPost. ssh runs with no socket when the file is there, and
# ExecStartPost takes the old file for the new one.
ExecStartPre=/usr/bin/rm -f %h/.local/state/ssh-github-mux/sock/github
ExecStart=/usr/bin/ssh -F none -N \
    -o BatchMode=yes \
    -o ControlMaster=yes \
    -o ControlPath=%h/.local/state/ssh-github-mux/sock/github \
    -o ControlPersist=no \
    -o IdentitiesOnly=yes \
    -o IdentityAgent=%t/ssh-agent-gate/sock \
    -o IdentityFile=%h/.ssh/github-seb-odoo.pub \
    -o ServerAliveCountMax=3 \
    -o ServerAliveInterval=10 \
    git@github.com
# A new file renamed in place replaces a link left there (security check 11-03, S4 leftovers).
ExecStartPost=/bin/sh -c 'until [ -S %h/.local/state/ssh-github-mux/sock/github ]; do \
    kill -0 $$MAINPID 2>/dev/null || exit 1; sleep 0.5; done; \
    f=$$(mktemp %h/.local/state/ssh-github-mux/up.XXXXXX) && \
    mv -fT "$$f" %h/.local/state/ssh-github-mux/sock/up'
SuccessExitStatus=255
ExecStopPost=/usr/bin/rm -f %h/.local/state/ssh-github-mux/sock/github
ExecStopPost=/bin/sh -c 'f=$$(mktemp %h/.local/state/ssh-github-mux/stopped.XXXXXX) && \
    mv -fT "$$f" %h/.local/state/ssh-github-mux/sock/stopped'
# No socket in this run: the hok card of the key was not answered in time, or was refused, so
# hold the next one.
ExecStopPost=/bin/sh -c '[ -e %h/.local/state/ssh-github-mux/sock/up ] || \
    { f=$$(mktemp %h/.local/state/ssh-github-mux/held.XXXXXX) && \
    mv -fT "$$f" %h/.local/state/ssh-github-mux/request/held; }'
