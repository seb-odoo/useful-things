#!/bin/bash
set -e
ram=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ssh-sign.sock
prompt='Master password (Tab shows it): '

ask_password() {
    local char shown=
    password=
    printf '%s' "$prompt" >&2
    while :; do
        IFS= read -rsn1 char || exit 1
        case $char in
            '') break ;;
            $'\t') if [[ $shown ]]; then shown=; else shown=1; fi ;;
            $'\177' | $'\b') password=${password%?} ;;
            *) password+=$char ;;
        esac
        printf '\r\033[K%s%s' "$prompt" "${shown:+$password}" >&2
    done
    printf '\nUnlocking the vault...\n' >&2
}

until [[ $password ]] && session=$(BW_PASSWORD=$password bw unlock --raw --passwordenv BW_PASSWORD); do
    (( $? == 1 )) || exit
    ask_password
done
unset password
trap 'bw lock >/dev/null' EXIT
# Offline at login is fine, bw get reads the local copy of the vault.
echo 'Syncing the vault...' >&2
BW_SESSION=$session bw sync >/dev/null 2>&1 || true
BW_SESSION=$session bw get item github-seb-odoo-signing | jq -r .sshKey.privateKey \
    | SSH_AUTH_SOCK=$ram ssh-add -
